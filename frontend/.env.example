# Where the site is served from. Used for canonical URLs and the sitemap.
VITE_SITE_ORIGIN=http://localhost:5183

# fixtures = read content from src/content (no backend needed)
# live     = read content from the /api/v1 backend
VITE_API_MODE=fixtures

# Analytics is off unless a real endpoint is configured.
VITE_ANALYTICS_ENDPOINT=
VITE_DEMO_CONTENT=false

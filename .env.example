# ---------------------------------------------------------------------------
# Copy to .env and fill in. Nothing here is a real credential.
# Brand-facing strings (name, city, phone) live in shared/src/brand.ts,
# NOT here - they are content, not configuration.
# ---------------------------------------------------------------------------

NODE_ENV=development
TZ=UTC

# --- API ---
API_PORT=4010
API_BASE_URL=http://localhost:4010
WEB_BASE_URL=http://localhost:5183
CORS_ORIGINS=http://localhost:5183

# --- Database ---
DATABASE_URL=postgresql://homecare:homecare_dev_pw@localhost:5436/homecare?schema=public

# --- Redis (BullMQ queues) ---
REDIS_URL=redis://localhost:6381

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_OTP_SECRET=change-me-otp
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# --- Field-level encryption for health data (DPDP Act 2023) ---
# 32-byte key, base64. node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=

# --- Object storage (S3 compatible; MinIO locally) ---
S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_BUCKET=homecare-documents
S3_ACCESS_KEY_ID=homecare_minio
S3_SECRET_ACCESS_KEY=homecare_minio_dev_pw
S3_FORCE_PATH_STYLE=true
S3_SIGNED_URL_TTL_SECONDS=300

# --- Notifications (no-op stubs in development) ---
SMS_PROVIDER=console
SMS_SENDER_ID=
EMAIL_PROVIDER=console
EMAIL_FROM=
OPS_NOTIFICATION_EMAIL=

# --- OTP ---
# In development the OTP is printed to the API log instead of sent.
OTP_DEV_ECHO=true

# --- Antivirus scanning of uploads ---
CLAMAV_HOST=
CLAMAV_PORT=3310
